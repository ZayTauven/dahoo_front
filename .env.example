# Copier en `.env.local` et renseigner les valeurs. Ne jamais versionner les fichiers .env.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : n'y mettre aucun secret serveur.

# URL de l'API Django
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Token public Mapbox (pk.*) — restreindre ses URL autorisées sur account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
