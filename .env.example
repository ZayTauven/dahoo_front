# Copier en `.env.local` et renseigner les valeurs. Ne jamais versionner les fichiers .env.
# Les variables NEXT_PUBLIC_* sont exposées au navigateur : n'y mettre aucun secret.

# URL de l'API Django, appelée uniquement côté serveur (relais /api/backend, pages publiques)
DAHOO_API_URL=http://localhost:8000

# Clé partagée avec l'API (même valeur que INTERNAL_PROXY_KEY côté backend) : transmet l'IP réelle
# des visiteurs pour la limitation de débit. Serveur uniquement, jamais NEXT_PUBLIC_.
DAHOO_PROXY_KEY=
# En-tête posé (et écrasé) par le reverse proxy de production avec l'IP du visiteur.
# Nginx : proxy_set_header X-Real-IP $remote_addr;
DAHOO_CLIENT_IP_HEADER=x-real-ip

# URL publique du site (liens absolus, SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token public Mapbox (pk.*) — restreindre ses URL autorisées sur account.mapbox.com
NEXT_PUBLIC_MAPBOX_TOKEN=
